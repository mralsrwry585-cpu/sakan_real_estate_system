@using MyRealEstate.Web.Helpers
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var ownerName = Context.Session.GetOwnerName() ?? "المالك";
    var initials = ownerName.Length > 2 ? ownerName[..2] : ownerName;
}

<aside class="sakan-sidebar" data-sidebar>
    <div class="sidebar-brand">
        <div class="rounded-3 gradient-primary text-primary-foreground fw-bold d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 1.1rem;">س</div>
        <div>
            <div class="fw-bold text-foreground" style="font-size: 0.9rem;">سكن</div>
            <div class="text-muted-foreground" style="font-size: 0.68rem;">لوحة المالك</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a class="sidebar-link @(controller == "Dashboard" ? "active" : "")" href="/owner/dashboard">
            <span><i class="bi bi-grid me-2"></i>لوحة القيادة</span>
        </a>
        <a class="sidebar-link @(controller == "Properties" || controller == "PropertyWizard" || controller == "PropertyDetails" || controller == "Media" ? "active" : "")" href="/owner/properties">
            <span><i class="bi bi-buildings me-2"></i>عقاراتي</span>
            <span class="badge-count">12</span>
        </a>
        <a class="sidebar-link @(controller == "ViewingRequests" ? "active" : "")" href="/owner/requests/viewings">
            <span><i class="bi bi-eye me-2"></i>طلبات المعاينة</span>
            <span class="badge-count">4</span>
        </a>
        <a class="sidebar-link @(controller == "BookingRequests" ? "active" : "")" href="/owner/requests/bookings">
            <span><i class="bi bi-calendar-check me-2"></i>طلبات الحجز</span>
            <span class="badge-count">7</span>
        </a>
        <a class="sidebar-link" href="#">
            <span><i class="bi bi-bar-chart me-2"></i>التحليلات</span>
        </a>
        <a class="sidebar-link" href="#">
            <span><i class="bi bi-bell me-2"></i>الإشعارات</span>
        </a>
        <a class="sidebar-link" href="#">
            <span><i class="bi bi-person me-2"></i>الملف الشخصي</span>
        </a>
        <a class="sidebar-link" href="#">
            <span><i class="bi bi-gear me-2"></i>الإعدادات</span>
        </a>
    </nav>

    <div class="p-3 border-top border-border">
        <div class="rounded-4 gradient-gold p-3 text-gold-foreground">
            <div class="fw-bold" style="font-size: 0.78rem;">ترقية إلى Pro</div>
            <div class="mt-1" style="font-size: 0.68rem; opacity: 0.8;">عقارات غير محدودة وأولوية في الدعم.</div>
            <button class="btn btn-light w-100 mt-2 btn-sm fw-bold">ترقية الآن</button>
        </div>
    </div>
</aside>
<div class="sidebar-mobile-backdrop" data-sidebar-backdrop></div>
