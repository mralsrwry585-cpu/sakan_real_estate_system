@{
    var modalId = ViewData["ModalId"]?.ToString() ?? "acceptBookingModal";
    var requestNumber = ViewData["RequestNumber"]?.ToString() ?? "";
    var tenantName = ViewData["TenantName"]?.ToString() ?? "";
    var propertyTitle = ViewData["PropertyTitle"]?.ToString() ?? "";
    var startDateLabel = ViewData["StartDateLabel"]?.ToString() ?? "";
    var durationLabel = ViewData["DurationLabel"]?.ToString() ?? "";
    var formAction = ViewData["FormAction"]?.ToString() ?? "";
}
<div class="sakan-modal-backdrop" id="@modalId" data-modal>
    <div class="sakan-modal modal-lg">
        <div class="modal-header-sakan modal-header-gradient">
            <div class="rounded-circle bg-white d-flex align-items-center justify-content-center bg-opacity-25 flex-shrink-0" style="width: 44px; height: 44px;">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0">قبول طلب الحجز</h5>
                <div class="opacity-75" style="font-size: 0.72rem;" dir="ltr">@requestNumber • @tenantName</div>
            </div>
        </div>
        <form method="post" action="@formAction">
            @Html.AntiForgeryToken()
            <div class="modal-body-sakan">
                <div class="rounded-3 bg-muted p-3 mb-4" style="font-size: 0.75rem;">
                    <div class="d-flex justify-content-between mb-1"><span class="text-muted-foreground">العقار</span><span class="fw-bold text-foreground">@propertyTitle</span></div>
                    <div class="d-flex justify-content-between mb-1"><span class="text-muted-foreground">تاريخ البداية</span><span class="fw-bold text-foreground" dir="ltr">@startDateLabel</span></div>
                    <div class="d-flex justify-content-between"><span class="text-muted-foreground">المدة</span><span class="fw-bold text-foreground">@durationLabel</span></div>
                </div>

                <div class="mb-3">
                    <div class="field-label">ملاحظة للمستأجر (اختياري)</div>
                    <textarea name="OwnerResponseNote" rows="3" class="form-control-sakan" placeholder="سعيد بموافقتك، سأتواصل معك خلال 24 ساعة لإتمام إجراءات العقد."></textarea>
                </div>

                <div class="alert-sakan-warning mb-0" style="font-size: 0.75rem;">
                    عند القبول، ستتحول حالة العقار تلقائياً إلى "محجوز".
                </div>
            </div>
            <div class="modal-footer-sakan">
                <button type="button" class="btn btn-outline" data-modal-close>إلغاء</button>
                <button type="submit" class="btn btn-success px-4 fw-bold shadow-card">تأكيد القبول</button>
            </div>
        </form>
    </div>
</div>
