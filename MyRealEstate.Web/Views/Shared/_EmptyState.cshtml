@{
    var icon = ViewData["Icon"]?.ToString() ?? "bi-inbox";
    var title = ViewData["Title"]?.ToString() ?? "لا توجد بيانات";
    var message = ViewData["Message"]?.ToString() ?? "لا توجد عناصر لعرضها حالياً.";
}
<div class="empty-state">
    <div class="empty-icon"><i class="bi @icon"></i></div>
    <h4 class="fw-bold mb-0">@title</h4>
    <p class="text-muted-foreground mb-0">@message</p>
</div>
