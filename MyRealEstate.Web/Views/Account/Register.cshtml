@model MyRealEstate.Web.Models.Account.RegisterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "إنشاء حساب مالك";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-7">
            <div class="stat-card shadow-elegant p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mx-auto rounded-4 gradient-primary text-primary-foreground fw-bold d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.6rem;">س</div>
                    <h2 class="h4 fw-bold mb-1">إنشاء حساب مالك</h2>
                    <p class="text-muted-foreground mb-0">انضم إلى سكن وابدأ بإدارة عقاراتك باحترافية.</p>
                </div>

                @if (TempData["Registered"] is string registeredMsg)
                {
                    <div class="alert alert-sakan-success mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i> @registeredMsg
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-sakan-danger mb-4" role="alert"></div>

                <form asp-action="Register" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold" asp-for="FullName">الاسم الكامل</label>
                            <input asp-for="FullName" class="form-control form-control-sakan" placeholder="مثال: أحمد المالكي" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold" asp-for="Mobile">رقم الجوال</label>
                            <input asp-for="Mobile" class="form-control form-control-sakan" placeholder="05xxxxxxxx" dir="ltr" />
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold" asp-for="NationalId">رقم الهوية</label>
                            <input asp-for="NationalId" class="form-control form-control-sakan" placeholder="10 أرقام" dir="ltr" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" asp-for="Email">البريد الإلكتروني</label>
                            <input asp-for="Email" class="form-control form-control-sakan" placeholder="name@example.com" dir="ltr" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold" asp-for="Password">كلمة المرور</label>
                            <input asp-for="Password" type="password" class="form-control form-control-sakan" placeholder="8 أحرف على الأقل" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold" asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-sakan" placeholder="أعد إدخال كلمة المرور" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="AgreeToTerms" class="form-check-input" type="checkbox" id="AgreeToTerms" />
                                <label class="form-check-label small" for="AgreeToTerms">
                                    أوافق على <a href="#" class="text-primary fw-bold">الشروط والأحكام</a> وسياسة الخصوصية.
                                </label>
                            </div>
                            <span asp-validation-for="AgreeToTerms" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-4 fw-bold">
                        <i class="bi bi-person-plus me-1"></i> إنشاء الحساب
                    </button>
                </form>

                <div class="text-center mt-4 small text-muted-foreground">
                    لديك حساب بالفعل؟
                    <a asp-action="Login" class="text-primary fw-bold">تسجيل الدخول</a>
                </div>
            </div>
        </div>
    </div>
</div>
