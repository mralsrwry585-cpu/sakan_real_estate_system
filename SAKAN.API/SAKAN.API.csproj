<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>

    <!-- OpenAPI / Swagger -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <!-- JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />


    <!-- EF Core Tools -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0-preview.3.25171.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

  </ItemGroup>


  <ItemGroup>

    <!-- Application Layer -->
    <ProjectReference Include="..\SAKAN.Application\SAKAN.Application.csproj" />

    <!-- Infrastructure Layer -->
    <ProjectReference Include="..\SAKAN.Infrastructure\SAKAN.Infrastructure.csproj" />

  </ItemGroup>


</Project>